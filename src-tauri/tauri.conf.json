{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Bossnet Proceduri",
  "version": "0.4.0",
  "identifier": "ro.bossnet.proceduri",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Bossnet Proceduri",
        "width": 1120,
        "height": 720,
        "minWidth": 820,
        "minHeight": 580,
        "center": true,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://localhost:8787 ws://localhost:1420 https://proceduri.teambossnet.ro; font-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Business",
    "copyright": "© 2026 Bossnet",
    "shortDescription": "Control intern pentru procedurile Bossnet",
    "longDescription": "Bossnet Proceduri centralizează pornirea și urmărirea proiectelor Shopify.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
